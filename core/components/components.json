{
  "components": [
    {
      "id": "libpulse",
      "title": "Audio tools",
      "group": "Voice",
      "kind": "system",
      "size": 2000000,
      "description": "pacat and parec, which record the microphone and play the voice through PipeWire or PulseAudio. The libpulse package.",
      "needed_by": [
        "local-live",
        "codex-live"
      ],
      "packages": [
        "libpulse"
      ],
      "bins": [
        "pacat",
        "parec"
      ]
    },
    {
      "id": "voxtype",
      "title": "Voxtype",
      "group": "Voice",
      "kind": "system",
      "aur": true,
      "size": 663000000,
      "description": "Turns what you say into text, with the speech model you already set up for dictation (Omarchy's). From the AUR: voxtype-bin.",
      "needed_by": [
        "local-live"
      ],
      "packages": [
        "voxtype-bin"
      ],
      "bins": [
        "voxtype"
      ]
    },
    {
      "id": "localai",
      "title": "LocalAI",
      "group": "Voice",
      "kind": "files",
      "size": 196718754,
      "description": "The engine the voices run on (localai.io): its official program, started only while a conversation or an installation needs it, and bound to this machine. Removing it removes the voices below too.",
      "needed_by": [
        "local-live"
      ],
      "dir": "localai",
      "remove_dir": true,
      "files": [
        {
          "name": "bin/local-ai",
          "exec": true,
          "url": "https://github.com/mudler/LocalAI/releases/download/v4.12.1/local-ai-v4.12.1-linux-amd64"
        }
      ]
    },
    {
      "id": "voice-piper-pt-br",
      "title": "Voice: Piper, Portuguese (Brazil)",
      "group": "Voices: Portuguese (Brazil)",
      "kind": "localai",
      "language": "pt",
      "engine": "piper",
      "size": 141000000,
      "shared_size": 78000000,
      "description": "The lightest voice: Piper, on the CPU, a fraction of a second per sentence. One voice per language, and its program is shared with the other Piper languages.",
      "needed_by": [
        "local-live"
      ],
      "requires": "localai",
      "backend": "localai@cpu-piper",
      "backend_dir": "cpu-piper",
      "model": {
        "gallery": "localai@voice-pt_BR-faber-medium",
        "name": "voice-pt_BR-faber-medium",
        "overrides": {
          "backend": "cpu-piper"
        }
      },
      "paths": [
        "backends/cpu-piper",
        "models/pt_BR-faber-medium.onnx",
        "models/pt_BR-faber-medium.onnx.json"
      ],
      "warmup": "Olá."
    },
    {
      "id": "voice-pocket-pt",
      "title": "Voice: Pocket TTS, Portuguese (Brazil)",
      "group": "Voices: Portuguese (Brazil)",
      "kind": "localai",
      "language": "pt",
      "engine": "pocket",
      "hf_language": "portuguese_24l",
      "size": 1930000000,
      "shared_size": 1180000000,
      "description": "Kyutai's Pocket TTS with its 24-layer Portuguese (Brazil) model, on the CPU: a more natural voice, about two seconds a sentence and 2 GB of memory while it runs. Its program is shared with the other Pocket TTS languages; its other voices (alba, rafael...) are fetched the first time you pick one.",
      "needed_by": [
        "local-live"
      ],
      "requires": "localai",
      "backend": "localai@cpu-pocket-tts",
      "backend_dir": "cpu-pocket-tts",
      "model": {
        "gallery": "localai@pocket-tts",
        "name": "pocket-pt",
        "overrides": {
          "backend": "cpu-pocket-tts",
          "options": [
            "default_voice:alba",
            "language:portuguese_24l"
          ]
        }
      },
      "paths": [
        "backends/cpu-pocket-tts",
        "hf"
      ],
      "warmup": "Olá."
    },
