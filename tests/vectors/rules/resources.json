    {"name":"the aggregate line","fn":"cpuTimes","args":["cpu  100 5 50 800 20 3 2 1 0 0\ncpu0 50 2 25 400 10 1 1 0 0 0\ncpu1 50 3 25 400 10 2 1 1 0 0\nintr 12345\n"],"expected":{"idle":820,"total":981},"source":"tests"},
    {"name":"idle includes iowait","fn":"cpuTimes","args":["cpu 1 2 3 4 5 6 7 8"],"expected":{"idle":9,"total":36},"source":"tests"},
    {"name":"four counters only","fn":"cpuTimes","args":["cpu 1 2 3 4"],"expected":{"idle":4,"total":10},"source":"added"},
    {"name":"three counters is null","fn":"cpuTimes","args":["cpu 1 2 3"],"expected":null,"source":"tests"},
    {"name":"no cpu line is null","fn":"cpuTimes","args":["intr 5\nctxt 6"],"expected":null,"source":"tests"},
    {"name":"empty is null","fn":"cpuTimes","args":[""],"expected":null,"source":"added"},
    {"name":"null is null","fn":"cpuTimes","args":[null],"expected":null,"source":"added"},
    {"name":"a non-number counter is null","fn":"cpuTimes","args":["cpu 1 2 x 4 5"],"expected":null,"source":"added"},
    {"name":"only the first eight counters count","fn":"cpuTimes","args":["cpu 1 1 1 1 1 1 1 1 100 100"],"expected":{"idle":2,"total":8},"source":"added"},
    {"name":"a ninth junk counter is ignored","fn":"cpuTimes","args":["cpu 1 1 1 1 1 1 1 1 junk"],"expected":{"idle":2,"total":8},"source":"added"},
    {"name":"the first cpu line wins","fn":"cpuTimes","args":["cpu 1 1 1 1\ncpu 9 9 9 9"],"expected":{"idle":1,"total":4},"source":"added"},
    {"name":"a leading space line","fn":"cpuTimes","args":["  cpu  1 2 3 4 5 6 7 8"],"expected":{"idle":9,"total":36},"source":"added"},
    {"name":"a per-cpu line alone is not it","fn":"cpuTimes","args":["cpu0 1 2 3 4"],"expected":null,"source":"added"},
    {"name":"tabs separate","fn":"cpuTimes","args":["cpu\t1\t2\t3\t4\t5"],"expected":{"idle":9,"total":15},"source":"added"},
    {"name":"windows line endings","fn":"cpuTimes","args":["cpu 1 2 3 4 5 6 7 8\r\ncpu0 1 2 3 4"],"expected":{"idle":9,"total":36},"source":"added"},
    {"name":"a blank first line","fn":"cpuTimes","args":["\ncpu 1 2 3 4"],"expected":{"idle":4,"total":10},"source":"added"},
    {"name":"a hex counter","fn":"cpuTimes","args":["cpu 0x10 0 0 0"],"expected":{"idle":0,"total":16},"source":"added"},
