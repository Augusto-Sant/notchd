    {"name":"an empty counter slot is not possible","fn":"cpuTimes","args":["cpu  1  2  3  4"],"expected":{"idle":4,"total":10},"source":"added"},
    {"name":"a malformed line then a good one is still null","fn":"cpuTimes","args":["cpu x y z w\ncpu 1 2 3 4"],"expected":null,"source":"added"},
    {"name":"an exponent counter","fn":"cpuTimes","args":["cpu 1e2 0 0 0"],"expected":{"idle":0,"total":100},"source":"added"},
    {"name":"two cpus","fn":"cpuCount","args":["cpu  100 5 50 800 20 3 2 1 0 0\ncpu0 50 2 25 400 10 1 1 0 0 0\ncpu1 50 3 25 400 10 2 1 1 0 0\nintr 12345\n"],"expected":2,"source":"tests"},
    {"name":"none","fn":"cpuCount","args":["cpu 1 2 3 4"],"expected":0,"source":"tests"},
    {"name":"null","fn":"cpuCount","args":[null],"expected":0,"source":"added"},
