#!/usr/bin/env python3
"""A fake core/components/install.py for the QML and visual tests
($NOTCHD_COMPONENTS_INSTALLER): `status` prints a canned state of every
component (or the one the last command left, in $NOTCHD_FAKE_COMPONENTS_DIR/
states.json); `install`, `cancel` and `remove` log "<verb> <id>" to
$NOTCHD_FAKE_COMPONENTS_DIR/log and change that state. Installs nothing."""
import json
import os
import sys

D = os.environ.get("NOTCHD_FAKE_COMPONENTS_DIR", "")


def entry(cid, kind="files", **kw):
    e = {"id": cid, "kind": kind, "installed": False, "active": False, "phase": "", "detail": "", "done": None,
         "total": None, "percent": None, "error": "", "removable": kind != "system", "disk": 0}
    e.update(kw)
    return e


DEFAULT = {e["id"]: e for e in [
    entry("libpulse", "system", installed=True, missing=[]),
    entry("voxtype", "system", missing=["voxtype-bin"]),
    entry("localai", installed=True, disk=196718754),
    entry("voice-piper-pt-br", "localai", phase="failed", error="Voice voice-pt_BR-faber-medium: could not download the model"),
    entry("voice-pocket-pt", "localai", active=True, phase="downloading", done=644000000, total=1500000000, percent=42),
    entry("voice-pocket-en", "localai", installed=True, disk=1900000000),
    entry("codex-live-audio", "system", missing=["gst-plugins-bad"]),
]}


def with_registry(states):
    """Every component of the real registry has a state: missing unless listed."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..", "..", "core", "components", "components.json")
    with open(path) as f:
        for c in json.load(f)["components"]:
            states.setdefault(c["id"], entry(c["id"], c["kind"], missing=list(c.get("packages", [])) if c["kind"] == "system" else []))
    return states


def load():
    if D and os.path.exists(os.path.join(D, "states.json")):
        with open(os.path.join(D, "states.json")) as f:
            return with_registry(json.load(f))
    return with_registry(dict(DEFAULT))


def main():
    verb = sys.argv[1] if len(sys.argv) > 1 else ""
    if verb == "status":
        print(json.dumps(load()))
        return 0
    cid = sys.argv[2] if len(sys.argv) > 2 else ""
    if D:
        os.makedirs(D, exist_ok=True)
        with open(os.path.join(D, "log"), "a") as f:
            f.write("%s %s\n" % (verb, cid))
        states = load()
        old = states.get(cid, entry(cid))
        if verb == "install":
            states[cid] = dict(old, active=True, phase="downloading", done=100, total=1000, percent=10, error="")
        else:
            states[cid] = entry(cid, old.get("kind", "files"))
        with open(os.path.join(D, "states.json"), "w") as f:
            json.dump(states, f)
    return 0


sys.exit(main())
