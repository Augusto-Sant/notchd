        },
        "action": {
          "type": "string"
        },
        "tooltip": {
          "type": "string"
        },
        "fill": {
          "type": "boolean"
        },
        "width": {
          "type": "number",
          "description": "A fixed width in design pixels."
        },
        "height": {
          "type": "number",
          "description": "A fixed height in design pixels."
        },
        "minWidth": {
          "type": "number",
          "description": "At least this wide, in design pixels."
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "style": {
          "type": "string",
          "enum": [
            "disc"
          ]
        },
        "size": {
          "type": "number"
        },
        "child": {
          "$ref": "#/$defs/Node"
        }
      },
      "required": [
        "t",
        "value"
      ]
    },
    "Equalizer": {
      "type": "object",
      "properties": {
