{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notchd.dev/schema/view.schema.json",
  "title": "notchd view tree, protocol v1",
  "description": "A module slot's tree of primitives (docs/architecture.md, Primitive tree). Unknown properties are allowed (minor versions add optional ones); an unknown `t` is not. The nesting, node-count and size limits are enforced by the core (notchd-proto's Validate), not expressible here.",
  "$ref": "#/$defs/Node",
  "$defs": {
    "Tone": {
      "type": "string",
      "enum": [
        "foreground",
        "muted",
        "faint",
        "accent",
        "danger",
        "success",
        "line"
      ]
    },
    "Token": {
      "type": "string",
      "enum": [
        "foreground",
        "background",
        "accent",
        "danger",
        "success",
        "muted",
        "faint",
        "line",
        "hover",
        "selected",
        "surface"
      ]
    },
    "TextSize": {
      "type": "string",
      "enum": [
        "caption",
        "bodySmall",
        "body",
        "heading",
        "display"
      ]
    },
    "Align": {
      "type": "string",
      "enum": [
        "start",
        "center",
        "end"
      ]
    },
    "Color": {
      "oneOf": [
        {
          "$ref": "#/$defs/Token"
        },
        {
          "type": "object",
          "properties": {
            "mix": {
              "type": "array",
              "minItems": 3,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/Token"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          },
          "required": [
            "mix"
          ]
        }
      ]
    },
    "Node": {
      "oneOf": [
        {
          "$ref": "#/$defs/Row"
        },
        {
          "$ref": "#/$defs/Column"
        },
        {
          "$ref": "#/$defs/Stack"
        },
        {
          "$ref": "#/$defs/Spacer"
        },
        {
          "$ref": "#/$defs/Text"
        },
        {
          "$ref": "#/$defs/Icon"
        },
        {
          "$ref": "#/$defs/Image"
        },
        {
          "$ref": "#/$defs/Progress"
        },
        {
          "$ref": "#/$defs/Meter"
        },
        {
          "$ref": "#/$defs/Equalizer"
        },
        {
          "$ref": "#/$defs/List"
        },
        {
          "$ref": "#/$defs/Button"
        },
        {
          "$ref": "#/$defs/Chip"
        },
        {
          "$ref": "#/$defs/Canvas"
        },
        {
          "$ref": "#/$defs/Surface"
        }
      ]
    },
    "Children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "Row": {
      "type": "object",
      "properties": {
        "t": {
          "const": "row"
        },
        "id": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "tooltip": {
          "type": "string"
        },
        "fill": {
          "type": "boolean"
        },
        "width": {
          "type": "number",
          "description": "A fixed width in design pixels."
        },
        "height": {
          "type": "number",
          "description": "A fixed height in design pixels."
        },
        "minWidth": {
          "type": "number",
          "description": "At least this wide, in design pixels."
        },
        "children": {
          "$ref": "#/$defs/Children"
        },
        "gap": {
          "type": "number"
        },
        "align": {
          "$ref": "#/$defs/Align"
        },
        "maxWidth": {
          "type": "number",
          "description": "At most this wide, in design pixels."
        }
      },
      "required": [
        "t",
        "children"
      ],
      "description": "Horizontal layout; fill:true on a child takes the rest."
    },
    "Column": {
      "type": "object",
      "properties": {
        "t": {
          "const": "column"
        },
        "id": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "tooltip": {
          "type": "string"
        },
        "fill": {
          "type": "boolean"
        },
        "width": {
          "type": "number",
          "description": "A fixed width in design pixels."
        },
        "height": {
          "type": "number",
          "description": "A fixed height in design pixels."
        },
        "minWidth": {
          "type": "number",
          "description": "At least this wide, in design pixels."
        },
        "children": {
          "$ref": "#/$defs/Children"
        },
        "gap": {
          "type": "number"
        },
        "align": {
          "$ref": "#/$defs/Align"
        },
        "maxWidth": {
          "type": "number",
          "description": "At most this wide, in design pixels."
        }
      },
      "required": [
        "t",
        "children"
      ]
    },
    "Stack": {
      "type": "object",
      "properties": {
        "t": {
          "const": "stack"
        },
        "id": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "tooltip": {
          "type": "string"
        },
        "fill": {
          "type": "boolean"
        },
        "width": {
          "type": "number",
          "description": "A fixed width in design pixels."
        },
        "height": {
          "type": "number",
          "description": "A fixed height in design pixels."
        },
        "minWidth": {
          "type": "number",
          "description": "At least this wide, in design pixels."
        },
        "children": {
          "$ref": "#/$defs/Children"
        },
        "align": {
          "$ref": "#/$defs/Align"
        }
      },
      "required": [
        "t",
        "children"
      ],
      "description": "Overlay, centered by default."
    },
    "Spacer": {
      "type": "object",
      "properties": {
        "t": {
          "const": "spacer"
        },
        "id": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "tooltip": {
          "type": "string"
        },
        "fill": {
          "type": "boolean"
        },
        "width": {
          "type": "number",
          "description": "A fixed width in design pixels."
        },
        "height": {
          "type": "number",
          "description": "A fixed height in design pixels."
        },
        "minWidth": {
          "type": "number",
          "description": "At least this wide, in design pixels."
        },
        "size": {
          "type": "number"
        }
      },
      "required": [
        "t"
      ]
    },
    "Text": {
      "type": "object",
      "properties": {
        "t": {
          "const": "text"
        },
        "id": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "tooltip": {
          "type": "string"
        },
        "fill": {
          "type": "boolean"
        },
        "width": {
          "type": "number",
          "description": "A fixed width in design pixels."
        },
        "height": {
          "type": "number",
          "description": "A fixed height in design pixels."
        },
        "minWidth": {
          "type": "number",
          "description": "At least this wide, in design pixels."
        },
        "text": {
          "type": "string"
        },
        "tone": {
          "$ref": "#/$defs/Tone"
        },
        "size": {
          "$ref": "#/$defs/TextSize"
        },
        "tabular": {
          "type": "boolean"
        },
        "elide": {
          "type": "string",
          "enum": [
            "end",
            "none"
          ]
        },
        "wrap": {
          "type": "boolean"
        },
        "maxWidth": {
          "type": "number"
        },
        "align": {
          "$ref": "#/$defs/Align"
        },
        "lines": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "t",
        "text"
      ],
      "description": "Always plain text."
    },
    "Icon": {
      "type": "object",
      "properties": {
        "t": {
          "const": "icon"
        },
        "id": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "tooltip": {
          "type": "string"
        },
        "fill": {
          "type": "boolean"
        },
        "width": {
          "type": "number",
          "description": "A fixed width in design pixels."
        },
        "height": {
          "type": "number",
          "description": "A fixed height in design pixels."
        },
        "minWidth": {
          "type": "number",
          "description": "At least this wide, in design pixels."
        },
        "glyph": {
          "type": "string"
        },
        "tone": {
          "$ref": "#/$defs/Tone"
        },
        "size": {
          "type": "number"
        }
      },
      "required": [
        "t",
        "glyph"
      ]
    },
    "Image": {
      "type": "object",
      "properties": {
        "t": {
          "const": "image"
        },
        "id": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "tooltip": {
          "type": "string"
        },
        "fill": {
          "type": "boolean"
        },
        "width": {
          "type": "number",
          "description": "A fixed width in design pixels."
        },
        "height": {
          "type": "number",
          "description": "A fixed height in design pixels."
        },
        "minWidth": {
          "type": "number",
          "description": "At least this wide, in design pixels."
        },
        "src": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "radius": {
          "type": "string",
          "enum": [
            "none",
            "small",
            "round"
          ]
        },
        "fit": {
          "type": "string",
          "enum": [
            "crop",
            "contain"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/Icon"
        }
      },
      "required": [
        "t",
        "src"
      ]
    },
    "Progress": {
      "type": "object",
      "properties": {
        "t": {
          "const": "progress"
        },
        "id": {
          "type": "string"
        },
        "visible": {
