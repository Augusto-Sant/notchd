        },
        "action": {
          "type": "string"
        },
        "tooltip": {
          "type": "string"
        },
        "fill": {
          "type": "boolean"
        },
        "width": {
          "type": "number",
          "description": "A fixed width in design pixels."
        },
        "height": {
          "type": "number",
          "description": "A fixed height in design pixels."
        },
        "minWidth": {
          "type": "number",
          "description": "At least this wide, in design pixels."
        },
        "value": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "orientation": {
          "type": "string",
          "enum": [
            "h",
            "v"
          ]
        },
        "tone": {
          "$ref": "#/$defs/Tone"
        },
        "thickness": {
          "type": "number"
        },
        "anchor": {
          "type": "object",
          "properties": {
            "at": {
              "type": "integer",
              "minimum": 0
            },
            "rate": {
              "type": "number"
            }
          },
          "required": [
            "at",
            "rate"
          ]
        },
        "seek": {
          "type": "string"
        }
      },
      "required": [
        "t"
      ]
    },
    "Meter": {
      "type": "object",
      "properties": {
        "t": {
          "const": "meter"
        },
        "id": {
          "type": "string"
        },
        "visible": {
